{
  "name": "legendshub",
  "version": "0.1.0",
  "description": "LegendsHub — LoL Esports Manager",
  "main": "dist-electron/main.js",
  "type": "module",
  "scripts": {
    "dev":              "vite --config vite.config.ts",
    "build":            "tsc --noEmit && vite build --config vite.config.ts",
    "preview":          "vite preview --config vite.config.ts",
    "electron:dev":     "concurrently \"vite --config vite.electron.config.ts\" \"electron .\"",
    "electron:build":   "tsc --noEmit && vite build --config vite.electron.config.ts && electron-builder",
    "typecheck":        "tsc --noEmit"
  },
  "keywords": ["league-of-legends", "esports", "manager", "game"],
  "author": "Davison",
  "license": "MIT",
  "dependencies": {
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-router-dom": "^6.22.0",
    "zustand": "^4.5.2",
    "idb": "^8.0.0",
    "clsx": "^2.1.0",
    "lucide-react": "^0.363.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "typescript": "^5.4.0",
    "vite": "^5.4.0",
    "tailwindcss": "^3.4.0",
    "autoprefixer": "^10.4.0",
    "postcss": "^8.4.0",
    "vite-plugin-electron": "^0.28.0",
    "vite-plugin-electron-renderer": "^0.14.0",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.0",
    "concurrently": "^8.2.0"
  },
  "build": {
    "appId": "com.davison.legendshub",
    "productName": "LegendsHub",
    "directories": { "output": "release" },
    "files": ["dist/**/*", "dist-electron/**/*"],
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "icon": "public/icon.ico"
    },
    "linux": {
      "target": "AppImage",
      "icon": "public/icon.png"
    }
  }
}
